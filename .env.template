# HADES environment template
#
# Reference for variables HADES recognizes during install and at runtime.
# The installer writes a subset of these to the install dir's .env. A few entries
# below (PYTHON_VERSION, GATEWAY_ALLOW_ALL_USERS) are honored at build/runtime via
# Docker Compose and the bootstrap script even when the host .env does not list them;
# add them to your .env if you want to override defaults.
#
# You do NOT normally edit this file by hand; the installer generates the .env for you.
# Use this to understand what each setting does, or to pre-seed a non-interactive install.
#
# Never commit a real .env with filled-in keys. Keep secrets out of version control.

# --- Core runtime ---

# Docker Compose project name. Equivalent to install.sh --name / install.ps1 -ProjectName.
COMPOSE_PROJECT_NAME=hades

# Which provider HADES talks to.
# One of: openrouter | anthropic | openai | google | deepseek | custom
MODEL_PROVIDER=openrouter

# Model identifier passed to the provider.
MODEL_NAME=deepseek/deepseek-v4-flash:free

# Host/API port the local server binds to (127.0.0.1 only).
API_SERVER_PORT=8642

# Bearer token for the local API server. The installer generates a random one.
# Leave blank to let the installer generate it; never reuse a provider key here.
API_SERVER_KEY=

# Build-time: install Chromium/Playwright browser tooling (1) or not (0).
# Off by default. Adds ~450 MB. Requires `hades update` to take effect.
INSTALL_BROWSER=0

# Pinned upstream Hermes Agent release tag.
HERMES_VERSION=v2026.5.29.2

# Docker base image variant used at build time.
PYTHON_VERSION=3.12-slim-bookworm

# GPU devices to pass to container (empty=no GPU). Example: "all", "device=0"
# Requires nvidia-container-toolkit on host. Used for local LLM inference.
GPU_DEVICES=

# Allow any API key to act as any user (true=permissive, false=strict).
# For single-user local installs, leave true. For multi-user or exposed API,
# set false and configure user mapping in Hermes gateway config.
GATEWAY_ALLOW_ALL_USERS=true

# Tool execution mode: manual (ask before each tool), auto (execute freely)
APPROVAL_MODE=manual

# --- Provider keys (fill only the one matching MODEL_PROVIDER) ---

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Custom OpenAI-compatible endpoint
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
